---
// A small link to buy the real board game, fixed in the lower-left corner of every page.
// It can be shrunk to an icon; that choice is remembered in this browser (localStorage).
const PRODUCT_URL = "https://wehrlegig.com/products/john-company-second-edition";
---

<aside class="buy-the-game" aria-label="Buy the board game" data-state="open">
  <a class="buy-card" href={PRODUCT_URL} target="_blank" rel="noopener">
    <span class="buy-kicker">Enjoying John Company?</span>
    <span class="buy-title">Buy the board game <span aria-hidden="true">↗</span></span>
    <span class="buy-by">from Wehrlegig Games</span>
  </a>
  <button type="button" class="buy-shrink" aria-label="Shrink the board game link">×</button>
  <a class="buy-icon" href={PRODUCT_URL} target="_blank" rel="noopener" aria-label="Buy the board game from Wehrlegig Games" title="Buy the board game from Wehrlegig Games">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d="M3 8.5 12 4l9 4.5v8L12 21l-9-4.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      <path d="M3 8.5 12 13l9-4.5M12 13v8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    </svg>
  </a>
  <button type="button" class="buy-grow" aria-label="Show the board game link">‹</button>
</aside>

<script>
  const KEY = "john-company.buy-link";
  for (const aside of document.querySelectorAll<HTMLElement>(".buy-the-game")) {
    try {
      if (localStorage.getItem(KEY) === "small") aside.dataset.state = "small";
    } catch {
      // Storage refused (private window): start open.
    }
    const set = (state: "open" | "small") => {
      aside.dataset.state = state;
      try {
        localStorage.setItem(KEY, state);
      } catch {
        // Not remembered; fine.
      }
    };
    aside.querySelector(".buy-shrink")?.addEventListener("click", () => set("small"));
    aside.querySelector(".buy-grow")?.addEventListener("click", () => set("open"));
  }
</script>

<style>
  /* Room under the page so the last content can scroll clear of the fixed link. */
  :global(body) {
    padding-bottom: 76px;
  }
  .buy-the-game {
    position: fixed;
    z-index: 5;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: flex-start;
    gap: 2px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #201b15;
  }

  .buy-card,
  .buy-icon {
    border: 1px solid #c9b99f;
    background: #f7f1e6;
    box-shadow: 0 2px 8px rgba(43, 32, 20, 0.14);
    color: inherit;
    text-decoration: none;
  }

  .buy-card {
    display: grid;
    gap: 1px;
    padding: 7px 26px 8px 11px;
    border-radius: 8px;
    line-height: 1.25;
  }

  .buy-card:hover,
  .buy-card:focus-visible,
  .buy-icon:hover,
  .buy-icon:focus-visible {
    border-color: #8d1d34;
  }

  .buy-kicker {
    color: #6b5d4d;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .buy-title {
    color: #8d1d34;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .buy-by {
    color: #6b5d4d;
    font-size: 0.75rem;
  }

  .buy-shrink {
    margin-left: -24px;
    margin-top: 3px;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #6b5d4d;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
  }

  .buy-shrink:hover,
  .buy-shrink:focus-visible {
    background: #e2d8c6;
    color: #201b15;
  }

  .buy-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #8d1d34;
  }

  .buy-grow {
    align-self: center;
    width: 18px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #6b5d4d;
    font-size: 1rem;
    cursor: pointer;
  }

  .buy-the-game[data-state="open"] .buy-icon,
  .buy-the-game[data-state="open"] .buy-grow,
  .buy-the-game[data-state="small"] .buy-card,
  .buy-the-game[data-state="small"] .buy-shrink {
    display: none;
  }

  /* Keep the page's last lines scrollable above the link. */
  :global(body) {
    padding-bottom: 72px;
  }

  @media print {
    .buy-the-game {
      display: none;
    }
  }
</style>
