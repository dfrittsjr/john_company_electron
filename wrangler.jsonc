{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static site only for now: `astro build` writes ./dist and the Worker serves it.
  // A Worker script (e.g. a Durable Object per game) can be added later with "main".
  "name": "john-company",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
