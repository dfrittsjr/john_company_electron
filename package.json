{
  "name": "john-company",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial browser adaptation of John Company: Second Edition, served as Cloudflare Worker static assets.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "npm run dev",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "cf:preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:data": "vitest run src/tests/data",
    "test:rules": "vitest run src/tests/rules src/tests/engine",
    "test:save": "vitest run src/tests/save",
    "test:crown": "vitest run src/tests/crown",
    "verify": "npm run typecheck && npm run test",
    "harness": "tsx scripts/harness.ts"
  },
  "keywords": [
    "boardgame",
    "john-company",
    "astro",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "astro": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^24.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
