{
  // Type-checks the Cloudflare Worker (src/worker) against the Workers runtime instead of the DOM.
  // Runtime and binding types come from `npm run cf:types` (src/worker/worker-configuration.d.ts).
  // The main tsconfig.json excludes src/worker so the Astro/browser build never sees these types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/worker/**/*.ts"]
}
